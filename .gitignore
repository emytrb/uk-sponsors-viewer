# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.duckdb

# Database dumps / backups
*.dump
*.sql.gz
*.bak

